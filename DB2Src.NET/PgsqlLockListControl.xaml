<UserControl x:Name="userControl" x:Class="Db2Source.PgsqlLockListControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Db2Source"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800" Loaded="UserControl_Loaded">
    <UserControl.Resources>
        <ContextMenu x:Key="ContextMenuTerminateSession">
            <MenuItem x:Name="menuItemForceTerminateSession" Header="選択したセッションを強制終了" Command="{x:Static local:SessionCommands.Kill}"/>
            <MenuItem x:Name="menuItemAbortQuery" Header="選択したセッションで実行中のクエリを中止" Command="{x:Static local:SessionCommands.AbortQuery}"/>
        </ContextMenu>
        <local:DurationTextConverter x:Key="DurationTextConverter"/>
        <ItemsPanelTemplate x:Key="ListBoxItemsPanelLockEntry">
            <StackPanel Orientation="Horizontal"/>
        </ItemsPanelTemplate>
        <DataTemplate x:Key="ListBoxItemTemplateLockEntry">
            <Border BorderBrush="Gray" BorderThickness="1" Margin="2" Padding="4,2">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding ObjectName}"/>
                </StackPanel>
            </Border>
        </DataTemplate>
        <SolidColorBrush x:Key="ListBox.Static.Background" Color="#FFFFFFFF"/>
        <SolidColorBrush x:Key="ListBox.Static.Border" Color="#FFABADB3"/>
        <SolidColorBrush x:Key="ListBox.Disabled.Background" Color="#FFFFFFFF"/>
        <SolidColorBrush x:Key="ListBox.Disabled.Border" Color="#FFD9D9D9"/>
        <Style x:Key="ListBoxStyle1" TargetType="{x:Type ListBox}">
            <Setter Property="Background" Value="{StaticResource ListBox.Static.Background}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ListBox.Static.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="true"/>
            <Setter Property="ScrollViewer.PanningMode" Value="Both"/>
            <Setter Property="Stylus.IsFlicksEnabled" Value="False"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBox}">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="1" SnapsToDevicePixels="true">
                            <ScrollViewer Focusable="false" Padding="{TemplateBinding Padding}" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden">
                                <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                            </ScrollViewer>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="false">
                                <Setter Property="Background" TargetName="Bd" Value="{StaticResource ListBox.Disabled.Background}"/>
                                <Setter Property="BorderBrush" TargetName="Bd" Value="{StaticResource ListBox.Disabled.Border}"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsGrouping" Value="true"/>
                                    <Condition Property="VirtualizingPanel.IsVirtualizingWhenGrouping" Value="false"/>
                                </MultiTrigger.Conditions>
                                <Setter Property="ScrollViewer.CanContentScroll" Value="false"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="TreeViewItemTemplateLockInfo">
            <StackPanel Orientation="Vertical">
                <TextBlock Text="{Binding Session.Description}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="2"/>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" VerticalAlignment="Top">
            <ToolBarTray>
                <ToolBar>
                    <Button x:Name="buttonRefresh" ContentTemplate="{StaticResource ImageRollback14}" ToolTip="更新" Click="buttonRefresh_Click"/>
                    <Button x:Name="buttonStop" ContentTemplate="{StaticResource ImageTrash14}" ToolTip="セッションの強制終了/クエリの中断" Click="buttonStop_Click">
                        <Button.ContextMenu>
                            <DynamicResource ResourceKey="ContextMenuTerminateSession"/>
                        </Button.ContextMenu>
                    </Button>
                </ToolBar>
            </ToolBarTray>
        </StackPanel>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Margin="2" HorizontalAlignment="Left"
                Text="{Binding WaitSince, ElementName=userControl, Converter={StaticResource DurationTextConverter}, ConverterParameter=時間\,分\,秒, StringFormat={}ロック待ち時間:{0}}"/>
            <TreeView x:Name="treeViewLocks" Grid.Row="1">
                <TreeView.ContextMenu>
                    <DynamicResource ResourceKey="ContextMenuTerminateSession"/>
                </TreeView.ContextMenu>
                <TreeView.CommandBindings>
                    <CommandBinding Command="{x:Static local:SessionCommands.Kill}" Executed="KillSessionCommand_Executed" CanExecute="KillSessionCommand_CanExecute"/>
                    <CommandBinding Command="{x:Static local:SessionCommands.AbortQuery}" Executed="AbortQueryCommand_Executed" CanExecute="AbortQueryCommand_CanExecute"/>
                </TreeView.CommandBindings>
            </TreeView>

            <GridSplitter Grid.Row="2" Height="4" HorizontalAlignment="Stretch" VerticalAlignment="Top"/>
            <DockPanel Grid.Row="2" Margin="0,4,0,0">
                <StackPanel DockPanel.Dock="Top" Orientation="Vertical">
                    <StackPanel Orientation="Horizontal" Margin="2">
                        <TextBlock Text="Pid:"/>
                        <TextBox Text="{Binding SelectedItem.Header.Session.Pid, ElementName=treeViewLocks, Mode=OneWay}" IsReadOnly="True" MinWidth="64"/>
                        <TextBlock Text=" DB:"/>
                        <TextBox Text="{Binding SelectedItem.Header.Session.DatabaseName, ElementName=treeViewLocks, Mode=OneWay}" IsReadOnly="True" MinWidth="64"/>
                        <TextBlock Text=" ユーザー:"/>
                        <TextBox Text="{Binding SelectedItem.Header.Session.UserName, ElementName=treeViewLocks, Mode=OneWay}" IsReadOnly="True" MinWidth="64"/>
                        <TextBlock Text=" 接続元:"/>
                        <TextBox Text="{Binding SelectedItem.Header.Session.ClientText, ElementName=treeViewLocks, Mode=OneWay}" IsReadOnly="True" MinWidth="64"/>
                        <TextBlock Text=" アプリケーション:"/>
                        <TextBox Text="{Binding SelectedItem.Header.Session.ApplicationName, ElementName=treeViewLocks, Mode=OneWay}" IsReadOnly="True" MinWidth="64"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="2">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedItem.Header.WaitingLock, ElementName=treeViewLocks}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Foreground="Red" FontWeight="Bold">
                            <TextBlock.Text>
                                <MultiBinding StringFormat="{}Pid={0}の処理完了を待っています:{1}">
                                    <Binding Path="SelectedItem.Header.WaitingLock.Pid" ElementName="treeViewLocks"/>
                                    <Binding Path="SelectedItem.Header.WaitSince" ElementName="treeViewLocks" Converter="{StaticResource DurationTextConverter}" ConverterParameter="時間,分,秒"/>
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </StackPanel>
                    <TextBox Text="{Binding SelectedItem.Header.Query, ElementName=treeViewLocks}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" MinHeight="40" MaxHeight="80" ToolTip="選択したセッションで実行中のクエリ"/>
                </StackPanel>
                <DataGrid x:Name="dataGridTables" ItemsSource="{Binding SelectedItem.Header.Locks, ElementName=treeViewLocks}" AutoGenerateColumns="False" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="テーブル" Binding="{Binding ObjectName}"/>
                        <DataGridTextColumn Header="ロックモード" Binding="{Binding LockMode}"/>
                        <DataGridTextColumn Header="ロック待ち対象行" Binding="{Binding WaitForKeyDesc}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Grid>
    </DockPanel>
</UserControl>
